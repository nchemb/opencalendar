# ---- Database (Postgres; Supabase free tier works) ----
# Runtime connection. On Supabase use the *transaction* pooler (port 6543).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations only. On Supabase use the *session* pooler (port 5432) or the direct connection.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ---- Admin dashboard ----
ADMIN_PASSWORD="change-me"
# Host account email. Must match the Google account you connect.
ADMIN_EMAIL="you@example.com"

# ---- Google Calendar OAuth ----
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# ---- Stripe (only needed for paid meeting types) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# With this set, the card fields render inline on the booking page (no redirect).
# Leave blank to fall back to Stripe's hosted Checkout page.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Email (optional; Google's calendar invite is the primary confirmation) ----
RESEND_API_KEY=""
RESEND_FROM="Bookings <bookings@example.com>"
# Where critical alerts go (calendar failures, revoked Google token, refunds).
ALERT_EMAIL="you@example.com"

# ---- Outbound webhook on confirmed booking (optional) ----
WEBHOOK_URL=""
WEBHOOK_SECRET=""

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Local Postgres via docker compose (see docker-compose.yml) ----
# DATABASE_URL="postgresql://bookkit:bookkit@localhost:5433/bookkit"
# DIRECT_URL="postgresql://bookkit:bookkit@localhost:5433/bookkit"

# ---- Demo instance (leave unset for a real deployment) ----
# Swaps in an in-memory calendar, refuses paid bookings, and shows a banner.
# Bookings never reach anybody's real calendar while this is on.
# BOOKKIT_DEMO_MODE="1"
# Shared secret for POST /api/demo/reset, called by the daily cron in vercel.json.
# DEMO_RESET_SECRET=""

# ---- Calendar backend (advanced) ----
# "google" (default) or "memory". The test suite sets memory; you should not
# need to touch this. Demo mode implies memory.
# BOOKKIT_CALENDAR="google"
